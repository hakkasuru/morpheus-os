{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/session-brief.sh\" --hook 2>/dev/null || true",
            "timeout": 45,
            "statusMessage": "Building session brief (open work, KB maintenance, priorities)…"
          }
        ]
      }
    ]
  }
}
